package lab05;

import java.util.ArrayList;
import java.util.HashSet;

public class Points {

    public static void main(String[] args) {
        
        ArrayList<Point> listaTablicowa = new java.util.ArrayList<Point>();
        HashSet<Point> setHaszowy = new java.util.HashSet<Point>();
        
        Point p = new Point(1, 2);
        
        setHaszowy.add(p);
        p.moved(4, 0);
        
        System.out.println(setHaszowy.contains(new Point(5, 2)));
        System.out.println(setHaszowy.contains(new Point(1, 2)));
        
        setHaszowy.remove(p);
