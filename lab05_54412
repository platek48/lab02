package lab05;

public class Point {
    int x;
    int y;
    
    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }
    
    Point moved(int dx, int dy) {
    	x += dx;
        y += dy;
    	return new Point(x, y);
    }
    

	@Override
    public boolean equals(Object o) {
        return o instanceof Point p && p.x == x && p.y == y;
    }
    
    @Override
    public int hashCode() {
        return java.util.Objects.hash(x, y);
    }
  
}
```

